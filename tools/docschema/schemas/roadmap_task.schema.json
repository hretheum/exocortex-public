{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roadmap_task.schema.json",
  "title": "Roadmap task file header",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^F\\d+\\.\\d+$"
    },
    "phase": {
      "type": "string",
      "pattern": "^F\\d+$"
    },
    "type": {
      "enum": [
        "serial"
      ]
    },
    "lang": {
      "enum": [
        "pl",
        "en"
      ]
    },
    "counterpart": {
      "type": "string",
      "pattern": "^(\\.\\./)+(pl|en)/.+\\.md$"
    },
    "status": {
      "enum": [
        "todo",
        "doing",
        "done"
      ]
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^F\\d+(\\.\\d+)?$"
      }
    },
    "estimate": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+)?[hd](-per-[a-z]+)?$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "enum": [
        "ai_authored",
        "human_authored",
        "mixed"
      ]
    },
    "provenance_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "human_validated": {
          "type": "boolean"
        }
      },
      "required": [
        "date",
        "human_validated"
      ]
    },
    "humanlint_exception": {
      "type": "string",
      "minLength": 10
    }
  },
  "required": [
    "id",
    "phase",
    "lang",
    "counterpart",
    "status",
    "depends_on",
    "estimate",
    "owner",
    "provenance",
    "provenance_metadata"
  ]
}
