# Allowlist: everything is excluded unless listed below.
# Keep in sync with the COPY lines in Dockerfile.
*
!exocortex/
!workers/
!schema/
!config/
!scripts/
!templates/
!plugins/
!vendor/
# used by deploy/postgres-age.Dockerfile and deploy/scheduler.Dockerfile
!deploy/postgres-init/
!deploy/crontab.docker
!requirements.txt
!pyproject.toml
!README.md
!LICENSE
!NOTICE
# gate image (deploy/gate/Containerfile)
!tools/
tools/tests/
tools/export/
!deploy/gate/
# engine Quadlet files shipped in the engine image
!deploy/quadlet/
# lab Quadlet units and the isolation check, shipped in the engine image
!deploy/lab/
# lab source allowlist (F2.2)
!lab/
# e2e image (deploy/e2e/Containerfile): the smoke test and its fixture notes
!deploy/e2e/
!tests/__init__.py
!tests/integration/__init__.py
!tests/integration/conftest.py
!tests/integration/test_end_to_end_mvp.py
!examples/acme-corp/notes/
**/__pycache__
**/*.pyc
config/.env
config/*.local.yaml
