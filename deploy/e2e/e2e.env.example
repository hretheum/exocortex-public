# ~/.config/exocortex-e2e/e2e.env — settings for the nightly e2e run.
# The image already defaults to a llama.cpp / llama-swap server on
# 127.0.0.1:8080 and the throwaway database on 127.0.0.1:55432.

# Telegram chat for failure alerts (the bot token comes from the podman
# secret gate_telegram_token). Empty = no alert, the unit still fails.
TELEGRAM_CHAT_ID=

# Model server, if not on 127.0.0.1:8080. The chat model is set in
# config/llm_routing.selfhosted.yaml inside the image (qwen3.6-35b-a3b);
# mount a replacement over it with a drop-in to use another model.
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# EXOCORTEX_EMBEDDING_MODEL=bge-m3

# Time limits for a slow model: whole run, and a multiplier for each step.
# E2E_BUDGET_SECONDS=1800
# E2E_TIMEOUT_SCALE=6
