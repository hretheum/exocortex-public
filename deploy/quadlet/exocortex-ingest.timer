# Ingest co godzine, ale WYLACZNIE w oknie ciszy 22:30-07:30 (spec K12) -
# oryginal (OnUnitActiveSec=1h calodobowo) strzelalby w dzien, a Standard
# Przegladu pkt 6 wymaga zera odpaleń miedzy 07:30 a 22:30.
[Unit]
Description=Exocortex — ingest (co godzine w oknie 22:30-07:30)

[Timer]
OnCalendar=*-*-* 22:30:00
OnCalendar=*-*-* 23:30:00
OnCalendar=*-*-* 00..06:30:00
RandomizedDelaySec=120
Persistent=false

[Install]
WantedBy=timers.target
