# Ingest every hour, but ONLY in the 22:30-07:30 quiet window (K12 spec) -
# the original (OnUnitActiveSec=1h around the clock) would fire during the day, and
# the review standard (item 6) requires zero runs between 07:30 and 22:30.
[Unit]
Description=Exocortex — ingest (co godzine w oknie 22:30-07:30)

[Timer]
OnCalendar=*-*-* 22:30:00
OnCalendar=*-*-* 23:30:00
OnCalendar=*-*-* 00..06:30:00
RandomizedDelaySec=120
Persistent=false

[Install]
WantedBy=timers.target
