# Ingest every hour, but ONLY in the 22:30-07:30 quiet window -
# deploy/systemd uses OnUnitActiveSec=1h around the clock, which would fire
# during the day; this deployment wants zero runs between 07:30 and 22:30.
[Unit]
Description=Exocortex — ingest (hourly in the 22:30-07:30 window)

[Timer]
OnCalendar=*-*-* 22:30:00
OnCalendar=*-*-* 23:30:00
OnCalendar=*-*-* 00..06:30:00
RandomizedDelaySec=120
Persistent=false

[Install]
WantedBy=timers.target
