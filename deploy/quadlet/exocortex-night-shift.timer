# 05:00 server LOCAL time (CET/CEST) - inside the 22:30-07:30 window. The
# deploy/systemd timer uses 05:00 UTC; in summer that is 07:00 local, right at
# the edge of the window - a fixed local 05:00 is independent of DST.
[Unit]
Description=Exocortex — night shift briefing (05:00)

[Timer]
OnCalendar=*-*-* 05:00:00
Persistent=false

[Install]
WantedBy=timers.target
