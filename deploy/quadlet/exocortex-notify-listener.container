# Exocortex — notify-listener (pg_notify -> Telegram push).
# Without TG_BOT_TOKEN it runs in degraded mode (log-only) - verified
# in notify_listener.py (lines 195-199). Token is optional, phase 7.
[Unit]
Description=Exocortex — notify-listener (pg_notify)
After=exocortex-db.service
Requires=exocortex-db.service

[Container]
Image=ghcr.io/hretheum/exocortex:main
ContainerName=exocortex-notify-listener
Network=host
EnvironmentFile=%h/.config/exocortex/exocortex.env
Volume=%h/.config/exocortex/llm_routing.local.yaml:/opt/exocortex/config/llm_routing.yaml:ro,z
Exec=python -u -m exocortex.notify_listener

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
