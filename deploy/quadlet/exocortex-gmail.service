# Exocortex K12 — Gmail adapter (newsletters from the "Read Later" label).
# Adapted from deploy/systemd/exocortex-gmail.service: instead of a native venv —
# podman run on the GHCR image (the pattern used across the K12 deployment).
#
# Found 2026-08-03: this unit had never been moved over from the droplet,
# so wiki/news/ had not been refreshed from May
# onward.
#
# The OAuth token (~/.config/second-brain/gmail_token.json, 0600) is mounted
# read-write because the Google library rewrites it after refreshing the access token.
# Token scope: gmail.readonly — the adapter never modifies the mailbox
# (remove_label_after_capture: false in sources.yaml).
#
# After fetching: the scorer (daemon, LISTEN content_acquired) processes the new
# sources via processors/newsletter.py — this CALLS the LLM locally (~11 s per
# newsletter), hence the night window and the --max-messages limit.
[Unit]
Description=Exocortex — adapter Gmail (newslettery -> Capture API)
After=exocortex-db.service exocortex-api.service

[Service]
Type=oneshot
ExecStart=/usr/bin/podman run --rm --network host --env-file %h/.config/exocortex/exocortex.env -v %h/.config/second-brain:/root/.config/second-brain:z -v %h/.config/exocortex/sources.yaml:/opt/exocortex/config/sources.yaml:ro,z --name exocortex-run-gmail ghcr.io/hretheum/exocortex:main python -u -m exocortex.sources.gmail --once --max-messages 40
ExecStartPost=/usr/bin/podman run --rm --network host --env-file %h/.config/exocortex/exocortex.env -v /var/home/hretheum/vault:/vault:z -v %h/.config/exocortex/llm_routing.local.yaml:/opt/exocortex/config/llm_routing.yaml:ro,z -v %h/.config/exocortex/sources.yaml:/opt/exocortex/config/sources.yaml:ro,z --name exocortex-run-gmail-compile ghcr.io/hretheum/exocortex:main python -u -m exocortex.wiki_compiler --domain news
# Language gate — THE SAME as in exocortex-compile. Without it, newsletter
# pages would reach the vault bypassing the correction layer that
# the rest of the wiki goes through (owner's note 2026-08-03). The script lints the whole
# wiki and fixes at most MIODEK_LIMIT_CORRECT (default 25) of the worst
# pages, so the cost is bounded regardless of how many newsletters
# came in. The miodek "openai" engine points at the local llama-swap
# (127.0.0.1:8080) — nothing leaves K12.
ExecStartPost=/var/home/hretheum/miodek/tools/bramka-wiki.sh
TimeoutStartSec=1h
