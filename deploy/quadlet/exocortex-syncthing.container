# Exocortex — Syncthing (vault sync Mac <-> K12).
# UserNS=keep-id: the image assumes UID 1000, the host user has UID 1000 - 1:1 mapping.
# GUI on loopback only (8384); transport 22000 tcp+udp MUST be reachable
# on the LAN (the only exception to the 127.0.0.1 rule in this deployment).
# Folder directions (source: bidirectional; wiki: K12 sends, Mac receives)
# are configured in Syncthing, not here - see the deployment docs.
[Unit]
Description=Exocortex — Syncthing (vault sync)
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/syncthing/syncthing:latest
ContainerName=exocortex-syncthing
UserNS=keep-id
Environment=STGUIADDRESS=0.0.0.0:8384
Volume=/var/home/hretheum/exocortex/syncthing-config:/var/syncthing/config:Z
Volume=/var/home/hretheum/vault:/var/syncthing/vault:z
PublishPort=127.0.0.1:8384:8384
PublishPort=22000:22000/tcp
PublishPort=22000:22000/udp

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
