# Exocortex — Postgres 16 + pgvector + Apache AGE.
# Image: ghcr.io/hretheum/exocortex-db (built in CI of the hretheum/exocortex repo).
# Listens ONLY on loopback (127.0.0.1:5432).
[Unit]
Description=Exocortex — Postgres (pgvector + AGE)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/hretheum/exocortex-db:latest
ContainerName=exocortex-db
EnvironmentFile=%h/.config/exocortex/exocortex.env
Volume=%h/exocortex/db-data:/var/lib/postgresql/data:Z
PublishPort=127.0.0.1:5432:5432
HealthCmd=pg_isready -U exocortex -d exocortex
HealthInterval=15s
HealthRetries=5

[Service]
Restart=always
TimeoutStartSec=180

[Install]
WantedBy=default.target
