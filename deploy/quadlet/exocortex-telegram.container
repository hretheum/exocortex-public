# Exocortex — Telegram bot worker (long-polling, exocortex.telegram_bot).
# F31.0.3. Polling, not webhook: the server is behind NAT,
# with no publicly routable address to receive a Telegram webhook.
# Without TG_BOT_TOKEN the process exits with code 2 (see exocortex/telegram_bot.py
# _main()) — Restart=on-failure does not loop forever thanks to
# RestartSec, but in practice the token is required for anything useful.
# Deny-by-default: TG_ALLOWED_USER_IDS must be set, otherwise the bot
# silently rejects every message (see the module docstring).
[Unit]
Description=Exocortex — Telegram bot (long-polling)
After=exocortex-db.service
Requires=exocortex-db.service

[Container]
Image=ghcr.io/hretheum/exocortex:main
ContainerName=exocortex-telegram
Network=host
EnvironmentFile=%h/.config/exocortex/exocortex.env
Volume=%h/vault:/vault:z
Volume=%h/.config/exocortex/llm_routing.local.yaml:/opt/exocortex/config/llm_routing.yaml:ro,z
Volume=%h/.config/exocortex/sources.yaml:/opt/exocortex/config/sources.yaml:ro,z
Exec=python -u -m exocortex.telegram_bot

[Service]
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
