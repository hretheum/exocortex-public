# Original: every 5 minutes around the clock. On K12 every 15 minutes and ONLY in the
# 22:30-07:30 window (review standard, item 6). Outside the window, events simply
# wait in the queue until evening.
[Unit]
Description=Exocortex — live sections (co 15 min w oknie)

[Timer]
OnCalendar=*-*-* 22:30..45/15:00
OnCalendar=*-*-* 23:00..45/15:00
OnCalendar=*-*-* 00..06:00..45/15:00
OnCalendar=*-*-* 07:00,15:00
Persistent=false

[Install]
WantedBy=timers.target
