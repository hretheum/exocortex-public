# 23:00 — night window, after gmail (22:45) and before synthesis (23:30), so freshly
# scored stories make it into the nightly run. Once a day is enough:
# the SF feeds publish a few items per day.
[Unit]
Description=Exocortex — RSS adapter (23:00)

[Timer]
OnCalendar=*-*-* 23:00:00
Persistent=false

[Install]
WantedBy=timers.target
