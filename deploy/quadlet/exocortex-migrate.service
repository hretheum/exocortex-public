# Exocortex — schema migrations (schema/*.sql via `exocortex migrate up --schema-dir /opt/exocortex/schema`).
# Run manually or via dependencies; safe to run repeatedly
# (always the same result, creates no duplicates) - verified
# by running it twice on an empty database on 2026-07-28.
# --schema-dir is explicit: the CLI entry point imports from site-packages and without this
# flag uses exocortex/_bundled/schema (frozen at wheel build time, may
# lag behind /opt/exocortex/schema from COPY . .) - measured 2026-07-28,
# migration 31 was invisible to the CLI even though the file was in the image.
# NOTE: lives in ~/.config/systemd/user/, NOT in the Quadlet directory - Quadlet
# only processes .container/.volume/..., a plain .service would not work there.
[Unit]
Description=Exocortex — migracje schematu bazy
After=exocortex-db.service
Requires=exocortex-db.service

[Service]
Type=oneshot
ExecStart=/usr/bin/podman run --rm --network host --env-file %h/.config/exocortex/exocortex.env ghcr.io/hretheum/exocortex:main exocortex migrate up --schema-dir /opt/exocortex/schema
TimeoutStartSec=300

[Install]
WantedBy=default.target
