# ~/.config/exocortex-lab/lab.env  (chmod 600)
# Lab settings. Secrets are podman secrets, never in this file:
#   lab_db_password     password of the lab database role
#   lab_database_url    postgresql://exocortex:<password>@exocortex-lab-db:5432/exocortex
#   lab_capture_token   bearer token of the lab Capture API
# Nothing in this file may point at the private instance.

TENANT_ID=00000000-0000-0000-0000-00000000100b
EXOCORTEX_TENANT_ID=00000000-0000-0000-0000-00000000100b
EXOCORTEX_VAULT_PATH=/vault
PG_AGE_GRAPH=exocortex

# Source allowlist baked into the image from the repository (F2.2). The
# isolation check fails if it is not set.
EXOCORTEX_SOURCE_ALLOWLIST=/opt/exocortex/lab/sources.yaml

# Addresses at which the private database could be reached if the separation
# failed. The isolation check tries every one and expects each to fail.
# host.containers.internal and 169.254.1.2 lead to the host loopback in
# rootless Podman; add the host's LAN addresses.
LAB_PRIVATE_DB_TARGETS=host.containers.internal:5432,169.254.1.2:5432,10.88.0.1:5432,exocortex-db:5432

# The gateway to the local model server (exocortex-lab-llm), a Unix socket in
# the exocortex-lab-llm volume. Lab processes reach models only through it;
# the isolation check tests it.
LAB_LLM_URL=unix:/run/lab-llm/gateway.sock

# The gateway for downloads from allowed sources (exocortex-lab-fetch), a Unix
# socket in the exocortex-lab-fetch volume. Checked by the isolation check.
LAB_FETCH_URL=unix:/run/lab-fetch/fetch.sock

# Outside addresses the isolation check expects to be unreachable from the
# lab. Default: 1.1.1.1:443, export.arxiv.org:443, host.containers.internal:8080,
# 169.254.1.2:8080. Add container addresses of other services on the host,
# e.g. the model server on its own container network.
#LAB_EGRESS_PROBES=1.1.1.1:443,export.arxiv.org:443,host.containers.internal:8080,169.254.1.2:8080
