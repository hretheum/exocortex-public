# Options of the next blind draw (exocortex-lab-blind@draw_<experiment>_<sample>). Empty means the default.
# Copy to ~/.config/exocortex-lab/blind.env; the blind unit reads it.
# Number of units in the sample (default: all usable units, shuffled)
LAB_BLIND_SIZE=
# Units shown twice, to measure the rater's agreement with themselves
LAB_BLIND_REPEATS=
# Seed of the draw (default: 20260930)
LAB_BLIND_SEED=
