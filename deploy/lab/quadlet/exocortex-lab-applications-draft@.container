# On demand, one experiment per instance: the business applications section
# of its hypothesis page (F8.1), for example
#   systemctl --user start "exocortex-lab-applications-draft@${SLUG}"   (SLUG=graph-vs-search)
# Reads the published documents folder of the vault and the exported data,
# both read-only, and calls a model from lab/models.yaml through the model
# gateway. Writes the Polish and English draft to the exocortex-lab-drafts
# volume, never to the vault. A draft always has publish: false and
# human_validated: false; approving it is the owner's step. No database and
# no secrets: the job needs neither.
[Unit]
Description=Exocortex lab — applications section draft for %i
Wants=exocortex-lab-llm.service
After=exocortex-lab-llm.service

[Container]
Image=ghcr.io/hretheum/exocortex-public:main
ContainerName=exocortex-lab-applications-draft-%i
Network=exocortex-lab.network
EnvironmentFile=%h/.config/exocortex-lab/lab.env
Volume=%h/vault/_source/dowody:/vault/_source/dowody:ro,z
Volume=exocortex-lab-out.volume:/lab-out:ro,z
Volume=exocortex-lab-llm.volume:/run/lab-llm:z
Volume=exocortex-lab-drafts.volume:/drafts:z
Exec=exocortex lab applications draft %i --root /vault/_source/dowody --data /lab-out/data --out /drafts --skip-name-check

[Service]
Type=oneshot
TimeoutStartSec=30min
