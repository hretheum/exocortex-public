#!/bin/bash
# exo — control the Exocortex jobs (systemd user units)
set -euo pipefail

BIEGI="ingest gmail rss compile synth night-shift live-sections gap-radar"

uzycie() {
  echo "exo <command> [job]"
  echo
  echo "  exo status              state of all units"
  echo "  exo timers              when the next runs are due"
  echo "  exo run <job>           start now and follow the log"
  echo "  exo logs <job> [n]      last n lines (default 40)"
  echo "  exo last                result of the last run of each job"
  echo
  echo "jobs: $BIEGI"
}

case "${1:-}" in
  status)
    systemctl --user list-units "exocortex*" --all --no-legend | sed "s/^ *//"
    ;;
  timers)
    systemctl --user list-timers "exocortex*" --no-legend | sed "s/^ *//"
    ;;
  run)
    [ -z "${2:-}" ] && { echo "give a job name"; uzycie; exit 1; }
    echo ">>> starting exocortex-$2"
    systemctl --user start "exocortex-$2.service"
    journalctl --user -u "exocortex-$2.service" -f -n 0 &
    P=$!
    while systemctl --user is-active --quiet "exocortex-$2.service"; do sleep 2; done
    sleep 1; kill $P 2>/dev/null || true
    echo
    systemctl --user is-failed --quiet "exocortex-$2.service" \
      && echo "### FAILED — exo logs $2" \
      || echo "### OK"
    ;;
  logs)
    [ -z "${2:-}" ] && { echo "give a job name"; exit 1; }
    journalctl --user -u "exocortex-$2.service" -n "${3:-40}" --no-pager
    ;;
  last)
    for b in $BIEGI; do
      R=$(systemctl --user show "exocortex-$b.service" -p Result --value 2>/dev/null || echo "?")
      T=$(systemctl --user show "exocortex-$b.service" -p InactiveEnterTimestamp --value 2>/dev/null | cut -d" " -f2-3)
      case "$R" in
        success) W="OK  " ;;
        "")      W="----" ;;
        *)       W="FAIL" ;;
      esac
      printf "%-16s %s  %-20s %s\\n" "$b" "$W" "${T:-never}" "$([ "$R" != "success" ] && [ -n "$R" ] && echo "($R)" || true)"
    done
    ;;
  *)
    uzycie
    ;;
esac
