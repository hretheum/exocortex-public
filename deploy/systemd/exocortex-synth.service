[Unit]
Description=Exocortex — daily synthesis run
Documentation=https://github.com/hretheum/exocortex docs/synthesis-runbook.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=exocortex
Group=exocortex
WorkingDirectory=/opt/exocortex
EnvironmentFile=/etc/exocortex.env
Environment=PYTHONUNBUFFERED=1
# F4.6.3: --missing-only collapses 165+ unchanged perspectives to 0 LLM calls.
# --cumulative-cost-stop 5.00 caps the 24h budget across all runs. Per-run
# cost-stop default ($1.50) still applies as inner guard.
# --triggered-by systemd: this file IS a systemd unit — "cron" belongs only
# in deploy/crontab* (audit 2026-07-28, docs/incidenty/2026-07-28-jednostki.md).
ExecStart=/opt/exocortex/.venv/bin/python -u /opt/exocortex/scripts/run_synthesizer.py --missing-only --all --triggered-by systemd --cumulative-cost-stop 5.00
StandardOutput=append:/var/log/exocortex/synth.log
StandardError=append:/var/log/exocortex/synth.log
TimeoutStartSec=2h
# Hardening — runtime is read-mostly Python + DB writes via local TCP.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/log/exocortex
# /opt/exocortex is read-only at runtime; deploy script (manual) handles updates.

[Install]
WantedBy=multi-user.target
