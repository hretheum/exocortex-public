[Unit]
# F6.2.1 — RSS adapter (one-shot fetch).
Description=Exocortex — RSS adapter (workers.sources.rss --once)
Documentation=https://github.com/hretheum/exocortex docs/capture-api-runbook.md
After=network-online.target exocortex-capture.service
Wants=network-online.target

[Service]
Type=oneshot
User=exocortex
Group=exocortex
WorkingDirectory=/opt/exocortex
EnvironmentFile=/etc/exocortex.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/exocortex/.venv/bin/python -u -m exocortex.sources.rss --once

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/log/exocortex

StandardOutput=append:/var/log/exocortex/rss.log
StandardError=append:/var/log/exocortex/rss.log
TimeoutStartSec=10m

[Install]
WantedBy=multi-user.target
