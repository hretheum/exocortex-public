[Unit]
Description=Nightly self-test of the publishing gate (sets the lock flag on failure)

[Service]
Type=oneshot
EnvironmentFile=%h/.config/exocortex-publisher/publisher.env
WorkingDirectory=%h/exocortex-publisher/repo
ExecStart=/bin/sh -ec '\
  args="--lock-file $PUBLISHER_LOCK --results %h/.local/state/exocortex-publisher/selftest.json"; \
  [ -f "$LEAKGATE_PRIVATE_CASES" ] && args="$args --private-cases $LEAKGATE_PRIVATE_CASES"; \
  %h/exocortex-publisher/venv/bin/python -m tools.leakgate selftest $args'
