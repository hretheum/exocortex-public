[Unit]
Description=Rebuild the simcheck index from the private corpus

[Service]
Type=oneshot
EnvironmentFile=%h/.config/exocortex-publisher/publisher.env
WorkingDirectory=%h/exocortex-publisher/repo
ExecStart=/bin/sh -ec '\
  args="--dir $SIMCHECK_CORPUS_DIR --out $SIMCHECK_INDEX.new"; \
  [ -n "$SIMCHECK_PG_DSN" ] && args="$args --pg-dsn $SIMCHECK_PG_DSN"; \
  [ -n "$SIMCHECK_EMBED_URL" ] && args="$args --embed-url $SIMCHECK_EMBED_URL"; \
  %h/exocortex-publisher/venv/bin/python -m tools.simcheck build-index $args; \
  rm -rf $SIMCHECK_INDEX.old; [ -d $SIMCHECK_INDEX ] && mv $SIMCHECK_INDEX $SIMCHECK_INDEX.old; \
  mv $SIMCHECK_INDEX.new $SIMCHECK_INDEX'
ExecStartPost=/usr/bin/systemctl --user try-restart exocortex-simcheck.service
Nice=15
