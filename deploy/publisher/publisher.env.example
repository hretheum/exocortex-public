# Copy to ~/.config/exocortex-publisher/publisher.env and chmod 600.
# Paths are on the server that runs the publisher. systemd does not expand
# %h in this file, so write absolute paths.

# Private HMAC key of the denylist (never in the repository)
LEAKGATE_HMAC_KEY_FILE=/home/YOUR_USER/.config/exocortex-publisher/hmac.key
# Private self-test cases with real names (optional, never in the repository)
LEAKGATE_PRIVATE_CASES=/home/YOUR_USER/.config/exocortex-publisher/private-cases.yaml

# Checkout of the public repository (cloned with a deploy key that can write to it only)
PUBLISHER_REPO=/home/YOUR_USER/exocortex-publisher/repo
# Folder synced from the vault (Syncthing, send-only on the laptop)
PUBLISHER_SOURCE=/home/YOUR_USER/sync/dowody
# Private corpus used for the similarity index
SIMCHECK_CORPUS_DIR=/home/YOUR_USER/sync/vault
SIMCHECK_PG_DSN=
SIMCHECK_EMBED_URL=
SIMCHECK_INDEX=/home/YOUR_USER/.local/share/exocortex-publisher/simcheck-index

PUBLISHER_LOCK=/home/YOUR_USER/.local/state/exocortex-publisher/gate.lock
PUBLISHER_LOG=/home/YOUR_USER/.local/state/exocortex-publisher/runs.jsonl
PUBLISHER_AUTHOR=Exocortex publisher <publisher@users.noreply.github.com>

# Notifications about held files: Telegram if both set, else e-mail if SMTP_HOST is set
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUBLISHER_NOTIFY_EMAIL=
