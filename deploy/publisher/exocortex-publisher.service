[Unit]
Description=Exocortex publisher: vault folder -> public repository, through the gate
After=network-online.target exocortex-simcheck.service
Wants=exocortex-simcheck.service

[Service]
Type=oneshot
EnvironmentFile=%h/.config/exocortex-publisher/publisher.env
WorkingDirectory=%h/exocortex-publisher/repo
# Update tools from the repository itself before the run, so the gate that
# runs is the gate that is published.
ExecStartPre=/usr/bin/git -C ${PUBLISHER_REPO} pull -q --ff-only
ExecStart=%h/exocortex-publisher/venv/bin/python -m tools.publisher run \
    --source ${PUBLISHER_SOURCE} --repo ${PUBLISHER_REPO} \
    --lock-file ${PUBLISHER_LOCK} --log-file ${PUBLISHER_LOG} \
    --simcheck-url http://127.0.0.1:8099 --author ${PUBLISHER_AUTHOR} --push
# exit 3 = gate locked; not a unit failure, the lock itself is the signal
SuccessExitStatus=3
Nice=10
