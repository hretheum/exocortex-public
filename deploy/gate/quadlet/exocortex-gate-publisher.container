# One publisher run: sparse checkout of the documents folder only, checks,
# commit, push. Started by exocortex-gate-publisher.timer.
# /source is the synced vault folder with the documents, read-only. Change
# the path with a drop-in if yours differs. /lab-out is the lab's output.
[Unit]
Description=Exocortex gate — publisher run
Wants=exocortex-gate-simcheck.service
After=exocortex-gate-simcheck.service

[Container]
Image=ghcr.io/hretheum/exocortex-gate:main
ContainerName=exocortex-gate-publisher
Pod=exocortex-gate.pod
EnvironmentFile=%h/.config/exocortex-gate/gate.env
Secret=leakgate_hmac_key,type=env,target=LEAKGATE_HMAC_KEY
Secret=gate_deploy_key,type=mount,target=/run/secrets/gate_deploy_key,mode=0400
Secret=gate_telegram_token,type=env,target=TELEGRAM_BOT_TOKEN
Volume=%h/vault/_source/dowody:/source:ro,z
# The lab's output (registry, generated pages, data), read-only. If the lab
# is not installed this is an empty volume, and nothing lab-owned changes.
Volume=exocortex-lab-out:/lab-out:ro,z
Environment=GATE_LAB_SOURCE=/lab-out
Volume=exocortex-gate-repo.volume:/repo
Volume=exocortex-gate-state.volume:/state
Exec=publish

[Service]
Type=oneshot
# 3 = gate locked by a failed self-test; the lock itself is the signal
SuccessExitStatus=3
TimeoutStartSec=20min
# When the run held something, the review desk is refreshed, so the held documents show up there
# (a failure here does not matter). The last line of the run log tells whether anything was held.
ExecStartPost=-/bin/sh -c "tail -n1 %h/.local/share/containers/storage/volumes/exocortex-gate-state/_data/runs.jsonl | grep -q 'held[^}]*/' && /usr/bin/systemctl --user start exocortex-gate-quarantine-sync.service"
