# Removes the request file first, so a request made during the run starts another one, then switches on the drafts approved on the desk, runs the
# publisher unit (which refreshes the desk when it held something). The publisher applies every gate as usual.
[Unit]
Description=Exocortex gate: run the publisher for a desk request

[Service]
Type=oneshot
ExecStart=/usr/bin/rm -f %h/.local/share/containers/storage/volumes/exocortex-gate-state/_data/publish-request
# Drafts approved on the desk are switched on first (a failure here does not stop the publisher)
ExecStart=-/usr/bin/systemctl --user start exocortex-gate-apply-approvals.service
ExecStart=/usr/bin/systemctl --user start exocortex-gate-publisher.service
