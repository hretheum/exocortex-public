# ~/.config/exocortex-gate/gate.env  (chmod 600)
# Secrets do not go here; they are podman secrets (see README.md).

# Repository the publisher writes to (the deploy key can write to this one only)
GATE_REPO_URL=git@github.com:hretheum/exocortex-public.git
GATE_BRANCH=main
GATE_SUBDIR=dowody
GATE_AUTHOR=Exocortex publisher <publisher@users.noreply.github.com>
GATE_PUSH=1

# Telegram chat for notifications about held files (token is a secret)
TELEGRAM_CHAT_ID=

# Private corpus for simcheck. The vault is mounted at /corpus. Excluded:
# the published documents (they would match themselves), working notes
# that quote them, and arXiv paper summaries (public texts; they are the
# calibration negatives). Never exclude client material. The protected
# corpus should hold what must not be published: client work and personal
# notes. Your own non-client project notes and feeds of public origin only
# produce false alarms; add their folders here and filter their rows in
# SIMCHECK_PG_QUERY (for example by raw_sources.uri or thought_type).
SIMCHECK_EXCLUDE=*/dowody/*,dowody/*,*/dowody-prywatne/robocze/*,dowody-prywatne/robocze/*,wiki/papers/*
SIMCHECK_PG_QUERY=SELECT id, body FROM thoughts WHERE body IS NOT NULL AND thought_type <> 'arxiv_paper'
# Embeddings (OpenAI-compatible), e.g. llama-swap on the host loopback
SIMCHECK_EMBED_URL=
SIMCHECK_EMBED_MODEL=bge-m3
# Rewriting model for calibration (OpenAI-compatible chat endpoint)
SIMCHECK_REWRITE_URL=
SIMCHECK_REWRITE_MODEL=
# Calibration: public negatives besides the published documents, sample
# size, allowed false alarm rate, and whether to apply the result at once.
SIMCHECK_CALIBRATION_PUBLIC=/corpus/wiki/papers/papers
SIMCHECK_CALIBRATION_SAMPLE=200
SIMCHECK_FA_BUDGET=0.05
SIMCHECK_CALIBRATION_APPLY=1
# Two-stage semantic check: similarity picks candidates, a local chat model
# (OpenAI-compatible) decides whether a candidate restates a private note.
# Calibration measures it when these are set; the service uses it once a
# report with a two_stage section has been applied. Empty = one stage.
SIMCHECK_JUDGE_URL=
SIMCHECK_JUDGE_MODEL=
SIMCHECK_STAGE1_MISS=0.02
# Language of the review page (pl or en)
GATE_REVIEW_LANG=en

# Quarantine and review desk (see README.md, "Quarantine and the review desk").
# The token is a podman secret mounted as a file; the desk does not start without it.
# GATE_QUARANTINE_DB=/state/quarantine.sqlite3
# GATE_DESK_TOKEN_FILE=/run/secrets/gate_desk_token
# GATE_NEVER_EXCLUDE_FILE=/etc/gate/never-exclude.txt
# GATE_CORPUS_DIR=/corpus
GATE_DESK_HOST=127.0.0.1
GATE_DESK_PORT=8770
GATE_DESK_USER=owner
