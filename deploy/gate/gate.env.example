# ~/.config/exocortex-gate/gate.env  (chmod 600)
# Secrets do not go here; they are podman secrets (see README.md).

# Repository the publisher writes to (the deploy key can write to this one only)
GATE_REPO_URL=git@github.com:hretheum/exocortex-public.git
GATE_BRANCH=main
GATE_SUBDIR=dowody
GATE_AUTHOR=Exocortex publisher <publisher@users.noreply.github.com>
GATE_PUSH=1

# Telegram chat for notifications about held files (token is a secret)
TELEGRAM_CHAT_ID=

# Private corpus for simcheck. The vault is mounted at /corpus. Excluded:
# the published documents (they would match themselves) and working notes
# that quote them. Never exclude client material.
SIMCHECK_EXCLUDE=*/dowody/*,dowody/*,*/dowody-prywatne/robocze/*,dowody-prywatne/robocze/*
SIMCHECK_PG_QUERY=SELECT id, body FROM thoughts WHERE body IS NOT NULL
# Embeddings (OpenAI-compatible), e.g. llama-swap on the host loopback
SIMCHECK_EMBED_URL=
SIMCHECK_EMBED_MODEL=bge-m3
# Rewriting model for calibration (OpenAI-compatible chat endpoint)
SIMCHECK_REWRITE_URL=
SIMCHECK_REWRITE_MODEL=
