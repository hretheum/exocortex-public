# Exocortex — environment variables.
#
# 1. Copy this file:    cp config/.env.example .env
# 2. Fill in the REQUIRED values (marked below).
# 3. Run:               exocortex migrate up
#
# Anything starting with "EXOCORTEX_" is consumed by ``exocortex/settings.py``
# via pydantic-settings; everything else is read directly by individual
# workers / scripts.


# ─── REQUIRED — docker compose ────────────────────────────────────────────────
#
# docker-compose.yml uses :? syntax (fail-fast) for these. Set them either in
# .env at the project root or in docker-compose.override.yml.

# Database password for the `db` service. Must match the password in DATABASE_URL.
POSTGRES_PASSWORD=

# Bearer token for /capture endpoint. Generate fresh:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CAPTURE_API_TOKEN=


# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Absolute path to your Obsidian vault root. Used by every worker that reads
# or writes notes (wiki compiler, vault watcher, FRP, journal publisher).
# Canonical name; ``VAULT_PATH`` and ``SECOND_BRAIN_VAULT_PATH`` are accepted
# as deprecated aliases for backward compatibility.
# Example:  /Users/you/Documents/my-vault
EXOCORTEX_VAULT_PATH=

# Postgres connection string used by all workers and the migrate CLI.
# Required for ``exocortex migrate up``. Self-hosted Postgres 16 + pgvector +
# Apache AGE — see docs/infrastructure.md for the server bootstrap.
# Example:  postgresql://exocortex:secret@localhost:5432/exocortex
# NOTE: variable is *unprefixed* by convention (every PaaS injects DATABASE_URL).
# EXOCORTEX_DATABASE_URL is also accepted for symmetry with the rest of Settings.
DATABASE_URL=


# ─── OPTIONAL — workers/CLI behaviour ────────────────────────────────────────

# Friendly vault name for ``obsidian://advanced-uri`` deep-links. When unset,
# the wiki compiler emits plain wikilinks instead of obsidian:// URLs.
# Look this up in Obsidian → Settings → About → Vault name.
# EXOCORTEX_VAULT_NAME=my-vault

# Tenant identifier (multi-tenant deployments). Single-user installs can
# leave the default.
# EXOCORTEX_TENANT_ID=default


# ─── OPTIONAL — LLM API keys ─────────────────────────────────────────────────
#
# Only set keys for providers you plan to use. The router falls back
# gracefully when a key is missing; tag extraction / synthesis simply skips
# their LLM step.

# Anthropic (claude-haiku for tag extraction, FRP generation, fallback).
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (embeddings).
# OPENAI_API_KEY=sk-...

# DeepInfra (Qwen — primary route for synthesis / aggregator). See
# config/llm_routing.yaml for the routing table.
# DEEPINFRA_API_TOKEN=

# OpenRouter (universal fallback). Disabled by default; set
# LLM_ROUTER_FALLBACK=off if you don't have a key but want hard-fails.
# OPENROUTER_API_KEY=
# LLM_ROUTER_FALLBACK=on


# ─── OPTIONAL — Capture API (FastAPI on :8000) ───────────────────────────────

# Bearer token clients must send when POSTing to /capture. Generate fresh:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# CAPTURE_API_TOKEN=
# CAPTURE_API_URL=http://localhost:8000


# ─── OPTIONAL — Notion integration (F21 + F30) ───────────────────────────────
#
# Two-token setup: SOURCE reads from a shared workspace, MIRROR writes back
# to your own. See docs/notion-sync-runbook.md.
# NOTION_TOKEN_SOURCE=secret_...
# NOTION_TOKEN_MIRROR=secret_...


# ─── OPTIONAL — Query telemetry (F28.1) ──────────────────────────────────────
#
# Log every GraphRAG / MCP query to the ``query_log`` table for observability.
# QUERY_LOG_ENABLED=1


# ─── OPTIONAL — Cockpit questions → GraphRAG (F31.3.4) ───────────────────────
#
# Every "Zapytaj mózg" question from the Notion cockpit is one paid model call
# (GraphRAG answer). The worker stops answering for the rest of the UTC day once
# either budget is used up and marks the question status='error' with the reason.
# Usage is counted from query_log (source='notion_cockpit_ask'). 0 = no questions.
# Estimate: ~$0.003–0.009 per question on the default route (Qwen 3.5 via
# DeepInfra), up to ~$0.014 on the claude-haiku fallback.
# EXOCORTEX_COCKPIT_ASK_MAX_QUESTIONS_PER_DAY=20
# EXOCORTEX_COCKPIT_ASK_MAX_COST_USD_PER_DAY=0.25
# EXOCORTEX_COCKPIT_ASK_TIMEOUT_S=120
